# BHOOMI-AI Environment Configuration

# Application
PROJECT_NAME="BHOOMI-AI"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite fallback:
DATABASE_URL="sqlite:///./bhoomi.db"
# Production PostgreSQL/PostGIS:
# DATABASE_URL="postgresql://postgres:bhoomi_secure_password@localhost:5432/bhoomi_db"

# Storage
STORAGE_PATH="./data/storage"
DEMO_PATH="./data/demo"

# AWS Deployment (Optional / Cloud Deployment)
# AWS_ACCESS_KEY_ID="your-aws-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret"
# AWS_REGION="ap-south-1"
# S3_BUCKET_NAME="bhoomi-cadastral-drone-storage"
